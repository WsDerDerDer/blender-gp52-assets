{
  "name": "six-emotions",
  "version": 1,
  "expressions": {
    "happy":   {"eyes": "arc",   "brows": "high", "mouth": "smile"},
    "calm":    {"eyes": "dot",   "brows": "flat", "mouth": "flat"},
    "surprised": {"eyes": "circle", "brows": "high", "mouth": "open"},
    "sad":     {"eyes": "line",  "brows": "inner_high", "mouth": "frown"},
    "sleepy":  {"eyes": "line",  "brows": "flat", "mouth": "small_o"},
    "angry":   {"eyes": "line",  "brows": "inner_low", "mouth": "wavy"}
  },
  "default": "calm",
  "notes": "接 skill cast 表情切片（demo_expressions 的 6 情绪矩阵）；值域见 asset-library 表情口型节"
